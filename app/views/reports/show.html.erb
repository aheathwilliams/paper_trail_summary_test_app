<% content_for :title, "Recent activity report" %>

<main class="shell report-shell">
  <header class="hero">
    <div>
      <p class="eyebrow">Batch reporting</p>
      <h1>Recent <span>activity report</span></h1>
      <p class="lede">
        See recent changes across articles with recorded article events in the
        selected window, including their selected child activity. Editing only a
        child does not select an otherwise quiet article.
      </p>
    </div>
    <%= link_to "Back to the studio", root_path, class: "button button-secondary" %>
  </header>

  <section class="panel">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Window</p>
        <h2><%= @window_label %></h2>
      </div>
    </div>

    <%= form_with url: report_path, method: :get, class: "report-form" do |form| %>
      <label>
        <span>Report on</span>
        <%= form.select :window,
                        ReportsController::WINDOWS.map { |key, meta| [ meta.fetch(:label), key ] },
                        { selected: @window_key },
                        onchange: "this.form.requestSubmit()" %>
      </label>
      <label>
        <span>Status at</span>
        <%= form.select :status_basis,
                        [["Current state", "current"], ["Recorded historical states", "historical"]],
                        { selected: @status_basis },
                        onchange: "this.form.requestSubmit()" %>
      </label>
      <label>
        <span>Articles matching</span>
        <%= form.select :status,
                        [ [ "Any status", ReportsController::ALL_STATUSES ] ] +
                          @statuses.map { |value| [ value.humanize, value ] },
                        { selected: @status },
                        onchange: "this.form.requestSubmit()" %>
      </label>
      <label>
        <span>Activity grouping</span>
        <%= form.select :group, [["By transaction", "transaction"], ["Individual events", "events"]],
                        { selected: @group ? "transaction" : "events" },
                        onchange: "this.form.requestSubmit()" %>
      </label>
      <%= form.submit "Run report", class: "button report-submit" %>
    <% end %>

    <div class="selection-explainer">
      <% if historical_status? %>
        <p class="lede">
          Historical status selects articles that matched in <strong>any state
          inside this window</strong>: as each was when the window started, and
          after each change inside it, including the latest. That holds even if
          their current status is different or they have since been deleted. The
          resulting activity covers their whole selected window, including changes
          in other statuses.
        </p>
        <p class="lede">
          It tests those states, not every instant of time, and an article created
          inside the window has no state before its creation to test.
        </p>
        <% if @status != ReportsController::ALL_STATUSES %>
          <p class="lede">
            The <%= ReportsController::LIMIT %>-root safety ceiling counts historical
            matches, including deleted roots, before live selection. Historical filtering
            also stops if it would load more than 10,000 candidate versions.
          </p>
        <% else %>
          <p class="lede">Any status applies no historical predicate and includes all candidates.</p>
        <% end %>
      <% else %>
        <p class="lede">
          Current status selects on the live table. An article that was
          <em>review</em> and is <em>approved</em> today will match Approved.
          Choose Recorded historical states to look for its earlier status instead.
          The <%= ReportsController::LIMIT %>-root safety ceiling covers selected
          live articles and the separate missing-root population together.
        </p>
      <% end %>
    </div>

    <p class="lede">
      Ending at <strong>now</strong> is the interesting part. A PaperTrail
      version stores the state that existed <em>before</em> its own event, so
      the last change inside the window has no later version to reveal it.
      <code>report</code> closes the window on the live record instead.
    </p>

    <p class="lede">
      Activity includes comments and replies, authorships and authors, and document
      metadata. Tag membership is available in the studio's endpoint comparison;
      live HABTM activity is unsupported. Grouped activity credits the first source
      event; one transaction can contain changes by multiple people.
    </p>

  </section>

  <section class="panel report-scenarios">
    <p class="eyebrow">Try the selection rules</p>
    <h2>Moved, deleted, and just changed</h2>
    <p>
      Add a small named dataset: an article that moved from Review to Approved,
      a deleted Review article, and one whose final event entered Review. Existing
      articles remain in place. Resetting the studio also clears these examples.
    </p>
    <%= button_to "Add historical status examples", report_examples_path, class: "button button-secondary" %>
  </section>

  <% if @deleted_histories.present? %>
    <section class="panel report-note">
      <p class="eyebrow">Reached by history, not by the relation</p>
      <p>
        These roots changed inside the window but have no live row left. A
        relation's conditions cannot run against a row that is gone, so the gem
        tests them against the state recorded when the root was deleted.
        Historical mode tests its recorded states in the window instead.
      </p>
      <% if historical_status? && @status != ReportsController::ALL_STATUSES %>
        <p>These deleted articles matched <strong><%= @status.humanize %></strong>
          at a recorded pre-event state in this window. Nonmatching histories are excluded.</p>
      <% elsif @status != ReportsController::ALL_STATUSES %>
        <p>These deleted articles were <strong><%= @status.humanize %></strong>
          when they were deleted. Articles deleted with another status are excluded.</p>
      <% else %>
        <p>Deleted history is shown separately, for every status.</p>
      <% end %>
      <p>Deleted activity includes the same explicitly requested associations as live activity.</p>
      <% @deleted_histories.each do |entry| %>
        <article class="report-card deleted-history">
          <h3><%= entry.title || "History unavailable" %> <code><%= entry.identity.inspect %></code></h3>
          <% if entry.steps %>
            <%= render "reports/activity", steps: entry.steps %>
          <% else %>
            <p>No destroy version is available to reconstruct this article.</p>
          <% end %>
        </article>
      <% end %>
      <% if @unreachable.length > ReportsController::DELETED_LIMIT %>
        <p>Showing the first <%= ReportsController::DELETED_LIMIT %> of
          <%= @unreachable.length %> missing articles. Narrow the time window to inspect more.</p>
      <% end %>
    </section>
  <% end %>

  <% if @report_error %>
    <section class="empty-state panel">
      <h2>The report could not run</h2>
      <pre><code><%= @report_error %></code></pre>
    </section>
  <% elsif @articles.empty? %>
    <section class="empty-state panel">
      <h2>No live articles with history match this report.</h2>
    </section>
  <% else %>
    <section class="panel">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Results</p>
          <h2><%= pluralize(changed_articles.length, "article") %> changed</h2>
          <p class="lede">
            <%= pluralize(reported_articles.length, "article") %> reached by the
            relation, of <%= pluralize(Article.count, "article") %> in total.
          </p>
        </div>
      </div>

      <% if reported_articles.empty? %>
        <p class="lede">
          The relation reached no articles with history in this window. Widen the
          window, or choose a status that some article currently holds.
        </p>
      <% elsif changed_articles.empty? %>
        <p class="lede">Nothing changed in this window. Widen it, or edit an article in the studio.</p>
      <% end %>

      <%# demo:code report.view %>
      <%# Scoped results are keyed by [item_type, item_id]; only selected roots
          with history in this window have entries. Activity can be visible even
          when edits cancel out and the net diff is empty. %>
      <% changed_articles.each do |article| %>
        <% analysis = analysis_for(article) %>
        <article class="report-card">
          <h3><%= link_to article.title, root_path(article_id: article.id) %></h3>
          <p class="activity-overview">Current status: <strong><%= article.status.humanize %></strong></p>

          <p class="activity-overview">
            <%= pluralize(analysis.timeline.length, "checkpoint") %> in this window
          </p>

          <%= render "reports/activity", steps: analysis.activity_timeline.reject(&:empty?) %>

          <p class="activity-change-heading">Net change across the window</p>
          <% if analysis.diff.empty? %>
            <p>The article returned to its starting state; its activity is shown above.</p>
          <% end %>

          <%# An article created inside the window has no prior state, so its
              whole diff is a presence change rather than field-by-field edits.
              A report that only rendered attributes would show these as blank. %>
          <% if analysis.diff.record_presence_change %>
            <%= render "demo/endpoint_presence_change", change: analysis.diff.record_presence_change %>
          <% end %>

          <% if analysis.diff.attributes.any? %>
            <p class="activity-change-heading">Fields</p>
            <ul class="activity-record-list">
              <% analysis.diff.attributes.each do |name, change| %>
                <li class="activity-record activity-record--changed">
                  <code><%= name %></code>
                  <span class="before"><%= change.from.inspect %></span>
                  <span class="arrow">→</span>
                  <span class="after"><%= change.to.inspect %></span>
                </li>
              <% end %>
            </ul>
          <% end %>

          <% if analysis.diff.associations.any? %>
            <p class="activity-change-heading">Associations</p>
            <ul class="activity-record-list">
              <% analysis.diff.associations.each do |name, association| %>
                <li class="activity-record">
                  <code><%= name %></code>
                  <%= render "demo/activity_association_diff", name: name, association: association %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </article>
      <% end %>
      <%# demo:code end %>

      <% if quiet_articles.any? %>
        <p class="activity-no-change">
          Unchanged in this window:
          <%= safe_join(quiet_articles.map { |a| link_to(a.title, root_path(article_id: a.id)) }, ", ") %>
        </p>
      <% end %>
    </section>
  <% end %>
  <%= render "demo/source", view: "report" %>
</main>
